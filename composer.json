{
    "name": "tyhpdef/php-di-invoker-impl",
    "description": "Implementation package for tyhpdef/php-di-invoker. Require tyhpdef/php-di-invoker, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.3.7.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-container": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/php-di-invoker"
        }
    },
    "require": {
        "php": ">=8.2",
        "php-di/invoker": "2.3.7"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-container": "@dev"
    }
}
